# Public site URL (used for absolute product links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production for CSRF + storefront session integrity
AUTH_SECRET=replace-with-long-random-string
CSRF_SECRET=replace-with-another-long-random-string

# --- CMS admin (server-only; never expose to the browser) ---
# Username or email used at /admin/login
CMS_ADMIN_USERNAME=admin
# bcrypt hash ONLY — generate with: npm run cms:hash-password
# Never put a plaintext password here.
CMS_ADMIN_PASSWORD_HASH=
# Long random secret used to sign CMS session cookies (min 32 chars)
CMS_SESSION_SECRET=replace-with-another-long-random-string

# Optional ops note only — does NOT grant CMS access
# ADMIN_EMAILS=owner@example.com

# Trust X-Forwarded-For only behind a known reverse proxy
TRUSTED_PROXY=false

# Optional flat shipping in PKR (leave unset = “to be confirmed”)
# SHIPPING_FLAT_PKR=250

# Optional payment toggles — never enable without real business confirmation
# ENABLE_COD=false
# ENABLE_BANK_TRANSFER=false
# BANK_TRANSFER_INSTRUCTIONS=
# ENABLE_CARD_TEST=false
# PAYMENT_PROVIDER=
# PAYMENT_TEST_SECRET=

# Optional SMTP for verification / reset / order emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# CSP upgrade only on real HTTPS deployments
# ENABLE_CSP_UPGRADE_INSECURE=false

# Persistent data directory (Coolify: mount volume at /data and set DATA_DIR=/data)
# DATA_DIR=/data
