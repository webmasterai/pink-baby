# Public site URL (used for absolute product links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production for CSRF + session integrity
AUTH_SECRET=replace-with-long-random-string
CSRF_SECRET=replace-with-another-long-random-string

# Comma-separated emails that receive admin role on register/login bootstrap
ADMIN_EMAILS=owner@example.com

# Trust X-Forwarded-For only behind a known reverse proxy
TRUSTED_PROXY=false

# Optional flat shipping in PKR (leave unset = “to be confirmed”)
# SHIPPING_FLAT_PKR=250

# Optional payment toggles — never enable without real business confirmation
# ENABLE_COD=false
# ENABLE_BANK_TRANSFER=false
# BANK_TRANSFER_INSTRUCTIONS=
# ENABLE_CARD_TEST=false
# PAYMENT_PROVIDER=
# PAYMENT_TEST_SECRET=

# Optional SMTP for verification / reset / order emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# CSP upgrade only on real HTTPS deployments
# ENABLE_CSP_UPGRADE_INSECURE=false
