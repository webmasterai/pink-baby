{
  "name": "pink-baby",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build && node scripts/prepare-standalone.mjs",
    "start": "node init && node .next/standalone/server.js",
    "start:next": "node init && next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "cms:migrate": "tsx scripts/cms-migrate.ts",
    "cms:migrate:dry": "tsx scripts/cms-migrate.ts --dry-run",
    "cms:hash-password": "node scripts/hash-cms-password.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "import:catalog:dry": "node scripts/import-catalog.mjs --dry-run",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "verify:assets": "node scripts/verify-deploy-assets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run verify:assets && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.14",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright-core": "^1.56.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
